DEFINE SCHEMA

    RECORD TYPE ActivityData (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        aggregationVersion       INT64,
        activityData             BYTES,
        date                     STRING SORTABLE,
        deviceID                 STRING QUERYABLE SORTABLE,
        schemaVersion            INT64,
        updatedAt                TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Metadata (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        salt            BYTES QUERYABLE SORTABLE,
        schemaVersion   INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE TokenUsage (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        aggregationVersion INT64,
        tokenUsage         BYTES,
        date               STRING SORTABLE,
        deviceID           STRING QUERYABLE SORTABLE,
        schemaVersion      INT64,
        updatedAt          TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
